# Application Settings
PROJECT_NAME="ResumeForge"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Security Settings
SECRET_KEY="change_this_to_a_secure_random_secret_key_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="resumeforge_user"
POSTGRES_PASSWORD="resumeforge_password"
POSTGRES_DB="resumeforge_db"
DATABASE_URL="postgresql://resumeforge_user:resumeforge_password@localhost:5432/resumeforge_db"

# Test Database Settings
TEST_DATABASE_URL="postgresql://resumeforge_user:resumeforge_password@localhost:5432/resumeforge_test_db"
